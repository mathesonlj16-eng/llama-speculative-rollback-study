+template <int NW, int R, bool PF>
+__global__ void __launch_bounds__(NW*32) bi_n1_q6_K_v2(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    __shared__ int   sbuf[NW][R][212];
+    __shared__ float scf[NW][R][32];
+    __shared__ float sdb[NW][32];
+    __shared__ float sda[NW][R][4];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*R;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, q = lane & 7, n = q >> 2, j = q & 3;
+    float acc[R];
+    int pf[R][7];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        acc[r] = 0.0f;
+        if (PF) {
+            const int nw0 = (210*min(4, nsb))/4;
+            const int * wr = (const int *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 7; ++i) { const int idx = lane + 32*i; if (idx < nw0) pf[r][i] = __ldg(wr + idx); }
+        }
+    }
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+        const int nwords = (210*nsbc)/4;
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            const int * wr = (const int *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 7; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < nwords) sbuf[wy][r][idx] = PF ? pf[r][i] : __ldg(wr + (210*sb0)/4 + idx);
+            }
+            if (PF && sb0 + 4 < nsb) {
+                const int nwn = (210*min(4, nsb - sb0 - 4))/4;
+#pragma unroll
+                for (int i = 0; i < 7; ++i) { const int idx = lane + 32*i; if (idx < nwn) pf[r][i] = __ldg(wr + (210*(sb0 + 4))/4 + idx); }
+            }
+        }
+        const int g = 8*(sb0 + sbl) + q;
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        float dB = 0.0f;
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dB = __ldg((const float *) by + (g & 3));
+            ya = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+            sdb[wy][lane] = dB;
+            const int base = 210*sbl;
+            const int oql = base + 64*n + 32*(j & 1);
+            const int oqh = base + 128 + 32*n;
+            const int shl = 4*(j >> 1), shh = 2*j;
+            const int yv[8] = {ya.x, ya.y, ya.z, ya.w, yb.x, yb.y, yb.z, yb.w};
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                const int * s32 = sbuf[wy][r];
+                int c0 = 0, c1 = 0;
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int ql = (bi_n1_ld32_2(s32, oql + 4*i) >> shl) & 0x0F0F0F0F;
+                    const int qh = ((bi_n1_ld32_2(s32, oqh + 4*i) >> shh) & 0x03030303) << 4;
+                    const int v  = __vsub4(ql | qh, 0x20202020);
+                    if (i < 4) c0 = __dp4a(v, yv[i], c0); else c1 = __dp4a(v, yv[i], c1);
+                }
+                const int8_t * sc = (const int8_t *) s32 + base + 192;
+                scf[wy][r][lane] = (float) (c0*sc[2*q] + c1*sc[2*q + 1]);
+                if (q == 0) {
+                    sda[wy][r][sbl] = __half2float(__ushort_as_half(*((const unsigned short *) ((const char *) s32 + base + 208))));
+                }
+            }
+        }
+        __syncwarp();
+        for (int h = 0; h < 2*nsbc; ++h) {
+            float tmp[R];
+            const float db0 = sdb[wy][4*h];
+#pragma unroll
+            for (int r = 0; r < R; ++r) tmp[r] = __fmaf_rn(scf[wy][r][4*h], db0, 0.0f);   // MMQ: tmp = Cf*dB + RZ
+#pragma unroll
+            for (int k = 1; k < 4; ++k) {
+                const float dbk = sdb[wy][4*h + k];
+#pragma unroll
+                for (int r = 0; r < R; ++r) tmp[r] = __fmaf_rn(scf[wy][r][4*h + k], dbk, tmp[r]);
+            }
+#pragma unroll
+            for (int r = 0; r < R; ++r) acc[r] = __fmaf_rn(tmp[r], sda[wy][r][h >> 1], acc[r]);   // MMQ: sum += tmp*dA
+        }
+        __syncwarp();
+    }
+    if (lane < R && row0 + lane < nrows) {
+        float out = acc[0];
+#pragma unroll
+        for (int r = 1; r < R; ++r) if (lane == r) out = acc[r];
+        dst[row0 + lane] = out;
+    }
+}
+
+// ================================================================ v3: lane-parallel fold across rows.
+// A warp handles RW rows. Compute phase: for each row r, lane = 32-value group (as before). Fold phase: lane r
+// folds row r's terms serially in ascending group order (the identical per-row float program), so the serial
+// chain costs 1/RW of a warp instruction per term instead of one. Shared rows padded to 33 entries (no bank conflicts).
+
+template <int NW, int RW>
+__global__ void __launch_bounds__(NW*32) bi_n1_q4_K_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    static_assert(RW >= 1 && RW <= 32, "RW");
+    __shared__ int4   sbuf[NW][RW][36];
+    __shared__ float4 sf[NW][RW][33];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, s = lane & 7;
+    float acc = 0.0f;   // lane r < RW: row row0 + r
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 9*nsbc) sbuf[wy][r][idx] = __ldg(wr + 9*sb0 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + s;
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        half2 dsh = __floats2half2_rn(0.0f, 0.0f);
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dsh = __ldg((const half2 *) by + (g & 3));
+            ya  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        const float2 dsB = __half22float2(dsh);
+        __syncwarp();
+        if (sbl < nsbc) {
+#pragma unroll 4
+            for (int r = 0; r < RW; ++r) {
+                const int * w = (const int *) sbuf[wy][r] + 36*sbl;
+                const half2 dm = *(const half2 *) w;
+                const int sc32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 0);
+                const int  m32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 2);
+                const uint8_t sc8 = (uint8_t) (sc32 >> (8*(s % 4)));
+                const uint8_t  m8 = (uint8_t) ( m32 >> (8*(s % 4)));
+                const half2 dmn = dm * make_half2(1.0f, -1.0f);
+                const float2 dmA = __half22float2(dmn * make_half2(sc8, m8));
+                const int4 * q4 = (const int4 *) (w + 4 + 8*(s/2));
+                const int4 qa = q4[0], qb = q4[1];
+                const int sh = 4*(s & 1);
+                int c = 0;
+                c = __dp4a((qa.x >> sh) & 0x0F0F0F0F, ya.x, c);
+                c = __dp4a((qa.y >> sh) & 0x0F0F0F0F, ya.y, c);
+                c = __dp4a((qa.z >> sh) & 0x0F0F0F0F, ya.z, c);
+                c = __dp4a((qa.w >> sh) & 0x0F0F0F0F, ya.w, c);
+                c = __dp4a((qb.x >> sh) & 0x0F0F0F0F, yb.x, c);
+                c = __dp4a((qb.y >> sh) & 0x0F0F0F0F, yb.y, c);
+                c = __dp4a((qb.z >> sh) & 0x0F0F0F0F, yb.z, c);
+                c = __dp4a((qb.w >> sh) & 0x0F0F0F0F, yb.w, c);
+                sf[wy][r][lane] = make_float4(__fmul_rn(dmA.x, dsB.x), (float) c, dmA.y, dsB.y);
+            }
+        }
+        __syncwarp();
+        if (lane < RW) {
+            const int ng = 8*nsbc;
+            for (int i = 0; i < ng; ++i) {
+                const float4 v = sf[wy][lane][i];
+                acc = __fmaf_rn(v.x, v.y, acc);   // MMQ: sum += (dmA.x*dsB.x)*C
+                acc = __fmaf_rn(v.z, v.w, acc);   // MMQ: sum += dmA.y*dsB.y
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW && row0 + lane < nrows) {
+        dst[row0 + lane] = acc;
+    }
+}
