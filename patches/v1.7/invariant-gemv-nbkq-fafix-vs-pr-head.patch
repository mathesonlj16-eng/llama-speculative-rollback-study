diff --git a/ggml/src/ggml-cuda/mmq-bi-n1-kq-v2.cuh b/ggml/src/ggml-cuda/mmq-bi-n1-kq-v2.cuh
new file mode 100644
index 0000000000..6bac7cc9d4
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-bi-n1-kq-v2.cuh
@@ -0,0 +1,451 @@
+#pragma once
+
+// v2 (performance) of the K-quant fast N=1 kernels in mmq-bi-n1-kq.cuh: the same float program per row
+// (see that header), restructured:
+//   - R rows per warp: each lane loads its activation group once for R rows, and R independent fold chains
+//     interleave (ILP for the serial FFMA chain);
+//   - fold operands packed per lane (Q4_K: one float4 = (dmA.x*dsB.x, Cf, dmA.y, dsB.y)) -> one LDS per term;
+//   - PF: prefetch the next chunk's weights into registers while the current chunk is computed.
+// Per-row operation order is unchanged: rows never mix, and the fold runs i (block) outer, r (row) inner.
+
+#include "mmq-bi-n1-kq.cuh"
+
+template <int NW, int R, bool PF>
+__global__ void __launch_bounds__(NW*32) bi_n1_q4_K_v2(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    __shared__ int4   sbuf[NW][R][36];
+    __shared__ float4 sf[NW][R][32];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*R;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, s = lane & 7;
+    float acc[R];
+    int4 pf[R][2];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        acc[r] = 0.0f;
+        if (PF) {
+            const int nsbc = min(4, nsb);
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 9*nsbc) pf[r][i] = __ldg(wr + idx);
+            }
+        }
+    }
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 9*nsbc) {
+                    sbuf[wy][r][idx] = PF ? pf[r][i] : __ldg(wr + 9*sb0 + idx);
+                }
+            }
+            if (PF && sb0 + 4 < nsb) {
+                const int nsbn = min(4, nsb - sb0 - 4);
+#pragma unroll
+                for (int i = 0; i < 2; ++i) {
+                    const int idx = lane + 32*i;
+                    if (idx < 9*nsbn) pf[r][i] = __ldg(wr + 9*(sb0 + 4) + idx);
+                }
+            }
+        }
+        const int g = 8*(sb0 + sbl) + s;
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        half2 dsh = __floats2half2_rn(0.0f, 0.0f);
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dsh = __ldg((const half2 *) by + (g & 3));
+            ya  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        const float2 dsB = __half22float2(dsh);
+        __syncwarp();
+        if (sbl < nsbc) {
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                const int * w = (const int *) sbuf[wy][r] + 36*sbl;
+                const half2 dm = *(const half2 *) w;
+                const int sc32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 0);
+                const int  m32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 2);
+                const uint8_t sc8 = (uint8_t) (sc32 >> (8*(s % 4)));
+                const uint8_t  m8 = (uint8_t) ( m32 >> (8*(s % 4)));
+                const half2 dmn = dm * make_half2(1.0f, -1.0f);
+                const float2 dmA = __half22float2(dmn * make_half2(sc8, m8));
+                const int4 * q4 = (const int4 *) (w + 4 + 8*(s/2));
+                const int4 qa = q4[0], qb = q4[1];
+                const int sh = 4*(s & 1);
+                int c = 0;
+                c = __dp4a((qa.x >> sh) & 0x0F0F0F0F, ya.x, c);
+                c = __dp4a((qa.y >> sh) & 0x0F0F0F0F, ya.y, c);
+                c = __dp4a((qa.z >> sh) & 0x0F0F0F0F, ya.z, c);
+                c = __dp4a((qa.w >> sh) & 0x0F0F0F0F, ya.w, c);
+                c = __dp4a((qb.x >> sh) & 0x0F0F0F0F, yb.x, c);
+                c = __dp4a((qb.y >> sh) & 0x0F0F0F0F, yb.y, c);
+                c = __dp4a((qb.z >> sh) & 0x0F0F0F0F, yb.z, c);
+                c = __dp4a((qb.w >> sh) & 0x0F0F0F0F, yb.w, c);
+                sf[wy][r][lane] = make_float4(__fmul_rn(dmA.x, dsB.x), (float) c, dmA.y, dsB.y);
+            }
+        }
+        __syncwarp();
+        const int ng = 8*nsbc;
+        for (int i = 0; i < ng; ++i) {
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                const float4 v = sf[wy][r][i];
+                acc[r] = __fmaf_rn(v.x, v.y, acc[r]);   // MMQ: sum += (dmA.x*dsB.x)*C
+                acc[r] = __fmaf_rn(v.z, v.w, acc[r]);   // MMQ: sum += dmA.y*dsB.y
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < R && row0 + lane < nrows) {
+        float out = acc[0];
+#pragma unroll
+        for (int r = 1; r < R; ++r) if (lane == r) out = acc[r];
+        dst[row0 + lane] = out;
+    }
+}
