+template <int NW, int RW>
+__global__ void __launch_bounds__(NW*32) bi_n1_q6_K_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    static_assert(RW >= 1 && RW <= 32, "RW");
+    __shared__ int   sbuf[NW][RW][212];
+    __shared__ float scf[NW][RW][33];
+    __shared__ float sdb[NW][32];
+    __shared__ float sda[NW][RW][5];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, q = lane & 7, n = q >> 2, j = q & 3;
+    float acc = 0.0f;
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+        const int nwords = (210*nsbc)/4;
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int * wr = (const int *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 7; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < nwords) sbuf[wy][r][idx] = __ldg(wr + (210*sb0)/4 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + q;
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        float dB = 0.0f;
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dB = __ldg((const float *) by + (g & 3));
+            ya = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+            sdb[wy][lane] = dB;
+            const int base = 210*sbl;
+            const int oql = base + 64*n + 32*(j & 1);
+            const int oqh = base + 128 + 32*n;
+            const int shl = 4*(j >> 1), shh = 2*j;
+            const int yv[8] = {ya.x, ya.y, ya.z, ya.w, yb.x, yb.y, yb.z, yb.w};
+#pragma unroll 2
+            for (int r = 0; r < RW; ++r) {
+                const int * s32 = sbuf[wy][r];
+                int c0 = 0, c1 = 0;
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int ql = (bi_n1_ld32_2(s32, oql + 4*i) >> shl) & 0x0F0F0F0F;
+                    const int qh = ((bi_n1_ld32_2(s32, oqh + 4*i) >> shh) & 0x03030303) << 4;
+                    const int v  = __vsub4(ql | qh, 0x20202020);
+                    if (i < 4) c0 = __dp4a(v, yv[i], c0); else c1 = __dp4a(v, yv[i], c1);
+                }
+                const int8_t * sc = (const int8_t *) s32 + base + 192;
+                scf[wy][r][lane] = (float) (c0*sc[2*q] + c1*sc[2*q + 1]);
+                if (q == 0) {
+                    sda[wy][r][sbl] = __half2float(__ushort_as_half(*((const unsigned short *) ((const char *) s32 + base + 208))));
+                }
+            }
+        }
+        __syncwarp();
+        if (lane < RW) {
+            for (int h = 0; h < 2*nsbc; ++h) {
+                float tmp = __fmaf_rn(scf[wy][lane][4*h], sdb[wy][4*h], 0.0f);       // MMQ: tmp = Cf*dB + RZ
+#pragma unroll
+                for (int k = 1; k < 4; ++k) {
+                    tmp = __fmaf_rn(scf[wy][lane][4*h + k], sdb[wy][4*h + k], tmp);  // MMQ: tmp += Cf*dB
+                }
+                acc = __fmaf_rn(tmp, sda[wy][lane][h >> 1], acc);                     // MMQ: sum += tmp*dA
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW && row0 + lane < nrows) {
+        dst[row0 + lane] = acc;
+    }
+}
+
+// ================================================================ Q8_0 v3: lane-parallel fold across RW rows.
+// Same per-row float program as mul_mat_bi_fast_n1_q8_0 (mmq-bi-n1.cu) / MMQ Turing:
+//   t_b = float(C_b)*dA_b (FMUL.FTZ);  sum = fma(t_b, dB_b, sum) (FFMA.FTZ), b ascending.
+// block_q8_0 = half d | int8 qs[32] (34 B); rows need ne00 % 1024 == 0 (32-block chunks, 1088 B, 16-B aligned).
+template <int NW, int RW>
+__global__ void __launch_bounds__(NW*32) bi_n1_q8_0_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nb) {
+    static_assert(RW >= 1 && RW <= 32, "RW");
+    __shared__ int4  sbuf[NW][RW][69];
+    __shared__ float st[NW][RW][33];
+    __shared__ float sd[NW][32];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int w0 = 8*lane + lane/2, sh = (lane & 1) * 16;
+    float acc = 0.0f;
+    const int nchunks = nb / 32;
+    for (int ch = 0; ch < nchunks; ++ch) {
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 3; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 68) sbuf[wy][r][idx] = __ldg(wr + 68*ch + idx);
+            }
+        }
+        const int b = 32*ch + lane;
+        const char * by = y + (int64_t) (b >> 2)*144;
+        const int4  ya = __ldg((const int4 *) (by + 16 + 32*(b & 3)) + 0);
+        const int4  yb = __ldg((const int4 *) (by + 16 + 32*(b & 3)) + 1);
+        sd[wy][lane] = __ldg((const float *) by + (b & 3));
+        __syncwarp();
+#pragma unroll 4
+        for (int r = 0; r < RW; ++r) {
+            const int * s32 = (const int *) sbuf[wy][r];
+            int w[9];
+#pragma unroll
+            for (int i = 0; i < 9; ++i) w[i] = s32[w0 + i];
+            const uint16_t dbits = uint16_t(uint32_t(w[0]) >> sh);
+            int c = 0;
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[0], (unsigned) w[1], 16 + sh), ya.x, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[1], (unsigned) w[2], 16 + sh), ya.y, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[2], (unsigned) w[3], 16 + sh), ya.z, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[3], (unsigned) w[4], 16 + sh), ya.w, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[4], (unsigned) w[5], 16 + sh), yb.x, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[5], (unsigned) w[6], 16 + sh), yb.y, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[6], (unsigned) w[7], 16 + sh), yb.z, c);
+            c = __dp4a((int) __funnelshift_rc((unsigned) w[7], (unsigned) w[8], 16 + sh), yb.w, c);
+            st[wy][r][lane] = __fmul_rn((float) c, __half2float(__ushort_as_half(dbits)));   // MMQ: FMUL.FTZ C*dA
+        }
+        __syncwarp();
+        if (lane < RW) {
+#pragma unroll 8
+            for (int i = 0; i < 32; ++i) {
+                acc = __fmaf_rn(st[wy][lane][i], sd[wy][i], acc);                          // MMQ: FFMA.FTZ sum += t*dB
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW && row0 + lane < nrows) {
+        dst[row0 + lane] = acc;
+    }
+}
diff --git a/ggml/src/ggml-cuda/mmq-bi-n1-kq.cuh b/ggml/src/ggml-cuda/mmq-bi-n1-kq.cuh
new file mode 100644
index 0000000000..bb5a285402
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-bi-n1-kq.cuh
@@ -0,0 +1,243 @@
+#pragma once
+
+// Batch-invariant fast N=1 GEMVs for Q4_K and Q6_K (research prototype, sm_75 Turing-MMA MMQ order).
+// Self-contained device code (cuda_fp16 only) so a standalone harness can include the exact same kernels.
+// Weights and the src1 buffer are read as raw bytes:
+//   block_q4_K: half2 dm | uint8 scales[12] | uint8 qs[128]                 = 144 B per 256 values
+//   block_q6_K: uint8 ql[128] | uint8 qh[64] | int8 scales[16] | half d     = 210 B per 256 values
+//   block_q8_1_mmq: 16 B header (DS4: half2 (d, s) x4  |  D4: float d x4) | int8 qs[128] = 144 B per 128 values
+//
+// Reproduced MMQ float programs (mmq-vec-dot.cuh @ 3f25ea199, Turing branch; checked against SASS of the PR build):
+//   Q4_K, per 32-value sub-block b ascending (:432-433):  sum = fma(dmA.x*dsB.x, (float)C_b, sum); sum = fma(dmA.y, dsB.y, sum)
+//         with dmA = half2(d, -dmin) * half2(sc_b, m_b) in fp16 (mmq-load-tiles.cuh:815-819)
+//   Q6_K, per 128-value half superblock h ascending (:1125-1160):
+//         tmp = 0; for g in 4 groups of 32: tmp = fma((float)(C_g0*sc_g0 + C_g1*sc_g1), dB_g, tmp);  sum = fma(tmp, d, sum)
+// MODE != 0 selects deliberately wrong float programs (negative controls for the harness only).
+
+#include <cuda_fp16.h>
+#include <cstdint>
+
+#define BI_N1_FULL_MASK 0xffffffffu
+
+static __device__ __forceinline__ int bi_n1_unpack_scales_q45_K(const int * scales, const int ksc) {
+    // copy of unpack_scales_q45_K (mmq-load-tiles.cuh:736-744)
+    return ((scales[(ksc%2) + (ksc!=0)] >> (4 * (ksc & (ksc/2)))) & 0x0F0F0F0F) |
+           ((scales[ksc/2]              >> (2 * (ksc % 2)))       & 0x30303030);
+}
+
+// ---------------------------------------------------------------- Q4_K
+// Q4_K MODEs: 0 prod; 1 (C*dsB.x)*dmA.x association; 2 m-term unfused (FMUL+FADD); 3 split-K even/odd sub-blocks;
+//             4 dmA products in fp32 (no fp16 rounding); 5 m-term before d-term
+template <int NW, int MODE>
+__global__ void __launch_bounds__(NW*32, 1) bi_n1_q4_K(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    __shared__ int4  sbuf[NW][36];
+    __shared__ float sp[NW][32], sc_[NW][32], smy[NW][32], sdy[NW][32];
+    const int row = blockIdx.x*NW + threadIdx.y;
+    if (row >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3;   // superblock within chunk
+    const int s   = lane & 7;    // 32-value sub-block within superblock
+    const int4 * wr = (const int4 *) (W + (int64_t) row*row_stride);
+    float acc = 0.0f, acc1 = 0.0f;
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int idx = lane + 32*i;
+            if (idx < 9*nsbc) {
+                sbuf[wy][idx] = __ldg(wr + 9*sb0 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + s;   // global 32-value group
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        half2 dsh = __floats2half2_rn(0.0f, 0.0f);
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dsh = __ldg((const half2 *) by + (g & 3));
+            ya  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb  = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+            const int * w = (const int *) sbuf[wy] + 36*sbl;
+            const half2 dm = *(const half2 *) w;
+            const int sc32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 0);
+            const int  m32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 2);
+            const uint8_t sc8 = (uint8_t) (sc32 >> (8*(s % 4)));
+            const uint8_t  m8 = (uint8_t) ( m32 >> (8*(s % 4)));
+            float2 dmA;
+            if (MODE == 4) {
+                const float2 dmf = __half22float2(dm);
+                dmA = make_float2(dmf.x*(float) sc8, -dmf.y*(float) m8);
+            } else {
+                const half2 dmn = dm * make_half2(1.0f, -1.0f);
+                dmA = __half22float2(dmn * make_half2(sc8, m8));
+            }
+            const int * q = w + 4 + 8*(s/2);
+            const int sh = 4*(s & 1);
+            int c = 0;
+            c = __dp4a((q[0] >> sh) & 0x0F0F0F0F, ya.x, c);
+            c = __dp4a((q[1] >> sh) & 0x0F0F0F0F, ya.y, c);
+            c = __dp4a((q[2] >> sh) & 0x0F0F0F0F, ya.z, c);
+            c = __dp4a((q[3] >> sh) & 0x0F0F0F0F, ya.w, c);
+            c = __dp4a((q[4] >> sh) & 0x0F0F0F0F, yb.x, c);
+            c = __dp4a((q[5] >> sh) & 0x0F0F0F0F, yb.y, c);
+            c = __dp4a((q[6] >> sh) & 0x0F0F0F0F, yb.z, c);
+            c = __dp4a((q[7] >> sh) & 0x0F0F0F0F, yb.w, c);
+            const float2 dsB = __half22float2(dsh);
+            if (MODE == 1) {
+                sp[wy][lane] = dmA.x;
+                sc_[wy][lane] = __fmul_rn((float) c, dsB.x);
+            } else {
+                sp[wy][lane] = __fmul_rn(dmA.x, dsB.x);   // MMQ: FMUL.FTZ dmA.x*dsB.x
+                sc_[wy][lane] = (float) c;
+            }
+            smy[wy][lane] = dmA.y;
+            sdy[wy][lane] = dsB.y;
+        }
+        __syncwarp();
+        const int ng = 8*nsbc;
+        for (int i = 0; i < ng; ++i) {
+            const float p = sp[wy][i], cf = sc_[wy][i], my = smy[wy][i], dy = sdy[wy][i];
+            if (MODE == 3) {
+                float & a = (i & 1) ? acc1 : acc;
+                a = __fmaf_rn(p, cf, a);
+                a = __fmaf_rn(my, dy, a);
+            } else if (MODE == 5) {
+                acc = __fmaf_rn(my, dy, acc);
+                acc = __fmaf_rn(p, cf, acc);
+            } else {
+                acc = __fmaf_rn(p, cf, acc);                                  // MMQ: FFMA.FTZ sum += (dmA.x*dsB.x)*C
+                acc = MODE == 2 ? __fadd_rn(acc, __fmul_rn(my, dy))           // control: unfused
+                                : __fmaf_rn(my, dy, acc);                     // MMQ: FFMA.FTZ sum += dmA.y*dsB.y
+            }
+        }
+        __syncwarp();
+    }
+    if (MODE == 3) {
+        acc = __fadd_rn(acc, acc1);
+    }
+    if (lane == 0) {
+        dst[row] = acc;
+    }
+}
+
+// ---------------------------------------------------------------- Q6_K
+// Q6_K MODEs: 0 prod; 1 flat fold (no per-128 tmp): sum = fma(Cf*dB, d, sum); 2 tmp starts with FMUL instead of fma(.,.,0);
+//             3 split-K over half superblocks (even/odd); 4 scales applied in fp32: tmp = fma(C0*sc0 + C1*sc1 in float, dB, tmp);
+//             5 reversed group order inside each half superblock
+static __device__ __forceinline__ int bi_n1_ld32_2(const int * s32, const int off) {
+    // 4-byte read at a 2-byte aligned byte offset
+    return (off & 2) ? (int) __funnelshift_r((unsigned) s32[off >> 2], (unsigned) s32[(off >> 2) + 1], 16) : s32[off >> 2];
+}
+
+template <int NW, int MODE>
+__global__ void __launch_bounds__(NW*32, 1) bi_n1_q6_K(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nsb) {
+    __shared__ int   sbuf[NW][212];
+    __shared__ float scf[NW][32], sdb[NW][32], sda[NW][4];
+    __shared__ float sc0f[NW][32], sc1f[NW][32];
+    const int row = blockIdx.x*NW + threadIdx.y;
+    if (row >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3;   // superblock within chunk
+    const int q   = lane & 7;    // 32-value group within superblock
+    const int n   = q >> 2, j = q & 3;
+    const int * wr = (const int *) (W + (int64_t) row*row_stride);   // row_stride % 4 == 0 (nsb even)
+    float acc = 0.0f, acc1 = 0.0f;
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);       // even, since nsb is even
+        const int nwords = (210*nsbc) / 4;
+#pragma unroll
+        for (int i = 0; i < 7; ++i) {
+            const int idx = lane + 32*i;
+            if (idx < nwords) {
+                sbuf[wy][idx] = __ldg(wr + (210*sb0)/4 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + q;
+        int4 ya = make_int4(0, 0, 0, 0), yb = make_int4(0, 0, 0, 0);
+        float dB = 0.0f;
+        if (sbl < nsbc) {
+            const char * by = y + (int64_t) (g >> 2)*144;
+            dB = __ldg((const float *) by + (g & 3));
+            ya = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+            yb = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+            const int * s32 = sbuf[wy];
+            const int base = 210*sbl;
+            const int oql = base + 64*n + 32*(j & 1);
+            const int oqh = base + 128 + 32*n;
+            const int shl = 4*(j >> 1), shh = 2*j;
+            int v[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const int ql = (bi_n1_ld32_2(s32, oql + 4*i) >> shl) & 0x0F0F0F0F;
+                const int qh = ((bi_n1_ld32_2(s32, oqh + 4*i) >> shh) & 0x03030303) << 4;
+                v[i] = __vsub4(ql | qh, 0x20202020);
+            }
+            int c0 = 0, c1 = 0;
+            c0 = __dp4a(v[0], ya.x, c0); c0 = __dp4a(v[1], ya.y, c0); c0 = __dp4a(v[2], ya.z, c0); c0 = __dp4a(v[3], ya.w, c0);
+            c1 = __dp4a(v[4], yb.x, c1); c1 = __dp4a(v[5], yb.y, c1); c1 = __dp4a(v[6], yb.z, c1); c1 = __dp4a(v[7], yb.w, c1);
+            const int8_t * sc = (const int8_t *) s32 + base + 192;
+            const int sc0 = sc[2*q + 0], sc1 = sc[2*q + 1];
+            if (MODE == 4) {
+                scf[wy][lane]  = (float) c0;
+                sc0f[wy][lane] = (float) sc0;
+                sc1f[wy][lane] = __fmul_rn((float) c1, (float) sc1);
+            } else {
+                scf[wy][lane] = (float) (c0*sc0 + c1*sc1);   // MMQ: IMAD, IMAD, I2F (exact)
+            }
+            sdb[wy][lane] = dB;
+            if (q == 0) {
+                sda[wy][sbl] = __half2float(__ushort_as_half(*((const unsigned short *) ((const char *) s32 + base + 208))));
+            }
+        }
+        __syncwarp();
+        for (int h = 0; h < 2*nsbc; ++h) {
+            const float dA = sda[wy][h >> 1];
+            if (MODE == 1) {
+                for (int k = 0; k < 4; ++k) {
+                    acc = __fmaf_rn(__fmul_rn(scf[wy][4*h + k], sdb[wy][4*h + k]), dA, acc);
+                }
+                continue;
+            }
+            float tmp;
+            if (MODE == 2) {
+                tmp = __fmul_rn(scf[wy][4*h], sdb[wy][4*h]);
+            } else if (MODE == 4) {
+                tmp = __fmaf_rn(__fmaf_rn(scf[wy][4*h], sc0f[wy][4*h], sc1f[wy][4*h]), sdb[wy][4*h], 0.0f);
+            } else if (MODE == 5) {
+                tmp = __fmaf_rn(scf[wy][4*h + 3], sdb[wy][4*h + 3], 0.0f);
+            } else {
+                tmp = __fmaf_rn(scf[wy][4*h], sdb[wy][4*h], 0.0f);           // MMQ: FFMA.FTZ tmp = Cf*dB + RZ
+            }
+            for (int k = 1; k < 4; ++k) {
+                const int kk = MODE == 5 ? 3 - k : k;
+                const float cf = MODE == 4 ? __fmaf_rn(scf[wy][4*h + kk], sc0f[wy][4*h + kk], sc1f[wy][4*h + kk]) : scf[wy][4*h + kk];
+                tmp = __fmaf_rn(cf, sdb[wy][4*h + kk], tmp);                 // MMQ: FFMA.FTZ tmp += Cf*dB
+            }
+            if (MODE == 3 && (h & 1)) {
+                acc1 = __fmaf_rn(tmp, dA, acc1);
+            } else {
+                acc = __fmaf_rn(tmp, dA, acc);                                // MMQ: FFMA.FTZ sum += tmp*dA
+            }
+        }
+        __syncwarp();
+    }
+    if (MODE == 3) {
+        acc = __fadd_rn(acc, acc1);
+    }
+    if (lane == 0) {
+        dst[row] = acc;
+    }
+}
diff --git a/ggml/src/ggml-cuda/mmq-bi-n1.cu b/ggml/src/ggml-cuda/mmq-bi-n1.cu
new file mode 100644
index 0000000000..a7a7fa4ffb
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-bi-n1.cu
@@ -0,0 +1,371 @@
+#include "mmq-bi-n1.cuh"
+#include "mmq-bi-n1-kq-v2.cuh"
+#include "mmq-bi-nb-kq.cuh"
+#include "mmq.cuh"
+#include "quantize.cuh"
+
+#include <cstdlib>
+#include <cstring>
+
+// One warp per row, one lane per Q8_0 block, chunks of 32 blocks (1088 B, 16-B aligned since ne00 % 1024 == 0).
+// Weights are loaded with coalesced 16-B loads (prefetched one chunk ahead), staged in shared memory and
+// realigned with funnel shifts. Each lane forms its block's integer dot (exact) and t = float(C)*dA; the
+// 32 (t, dB) pairs are then folded serially, in ascending block order, from shared memory.
+template <int nwarps>
+__launch_bounds__(nwarps*WARP_SIZE, 1)
+static __global__ void mul_mat_bi_fast_n1_q8_0(
+        const char * __restrict__ x, const int64_t stride_row_x, const block_q8_1_mmq * __restrict__ y,
+        float * __restrict__ dst, const int nrows, const int nblocks) {
+    __shared__ int4   sbuf[nwarps][69];
+    __shared__ float4 st[nwarps][8];
+    __shared__ float4 sd[nwarps][8];
+
+    const int row = blockIdx.x*nwarps + threadIdx.y;
+    if (row >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x;
+    const int wy   = threadIdx.y;
+    const int4 * xr = (const int4 *) (x + (int64_t) row*stride_row_x);
+    const int nchunks = nblocks / 32;
+
+    int4 pf[3];
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const int idx = lane + 32*i;
+        if (idx < 68) {
+            pf[i] = __ldg(xr + idx);
+        }
+    }
+
+    const int * s32 = (const int *) sbuf[wy];
+    const int w0 = 8*lane + lane/2;   // first 32-bit word of block `lane` (34 B per block)
+    const int sh = (lane & 1) * 16;   // odd blocks start on a 2-B boundary
+    float sum = 0.0f;
+    for (int ch = 0; ch < nchunks; ++ch) {
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+            const int idx = lane + 32*i;
+            if (idx < 68) {
+                sbuf[wy][idx] = pf[i];
+            }
+        }
+        if (ch + 1 < nchunks) {
+#pragma unroll
+            for (int i = 0; i < 3; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 68) {
+                    pf[i] = __ldg(xr + 68*(ch + 1) + idx);
+                }
+            }
+        }
+        const int b = 32*ch + lane;
+        const block_q8_1_mmq * by = y + (b >> 2);
+        const int4  ya = __ldg((const int4 *) (by->qs + 32*(b & 3)) + 0);
+        const int4  yb = __ldg((const int4 *) (by->qs + 32*(b & 3)) + 1);
+        const float dB = __ldg(&by->d4[b & 3]);
+        __syncwarp();
+
+        int w[9];
+#pragma unroll
+        for (int i = 0; i < 9; ++i) {
+            w[i] = s32[w0 + i];
+        }
+        const uint16_t dbits = uint16_t(uint32_t(w[0]) >> sh);
+        int v[8];
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            v[i] = (int) __funnelshift_rc((unsigned) w[i], (unsigned) w[i + 1], 16 + sh);
+        }
+        int c = ggml_cuda_dp4a(v[0], ya.x, 0);
+        c = ggml_cuda_dp4a(v[1], ya.y, c);
+        c = ggml_cuda_dp4a(v[2], ya.z, c);
+        c = ggml_cuda_dp4a(v[3], ya.w, c);
+        c = ggml_cuda_dp4a(v[4], yb.x, c);
+        c = ggml_cuda_dp4a(v[5], yb.y, c);
+        c = ggml_cuda_dp4a(v[6], yb.z, c);
+        c = ggml_cuda_dp4a(v[7], yb.w, c);
+        const float dA = __half2float(__ushort_as_half(dbits));
+        const float t  = __fmul_rn((float) c, dA);  // MMQ: FMUL.FTZ C*dA
+        ((float *) st[wy])[lane] = t;
+        ((float *) sd[wy])[lane] = dB;
+        __syncwarp();
+#pragma unroll
+        for (int q = 0; q < 8; ++q) {
+            const float4 tq = st[wy][q];
+            const float4 dq = sd[wy][q];
+            sum = __fmaf_rn(tq.x, dq.x, sum);  // MMQ: FFMA.FTZ sum += t*dB
+            sum = __fmaf_rn(tq.y, dq.y, sum);
+            sum = __fmaf_rn(tq.z, dq.z, sum);
+            sum = __fmaf_rn(tq.w, dq.w, sum);
+        }
+        __syncwarp();
+    }
+    if (lane == 0) {
+        dst[row] = sum;
+    }
+}
+
+// Q8_0, NC = 2..8 columns: the v3 kernel's per-(row, column) float program, unchanged, for each column.
+// Forced MMQ in invariant mode gives every column the N=1 result, so each output here is
+//   t_b = float(C_b)*dA_b (FMUL.FTZ);  sum = fma(t_b, dB_b[col], sum) (FFMA.FTZ), b ascending.
+// Weight rows are staged once per chunk and dotted against all NC activation columns; lane l < RW*NC folds
+// (row = l/NC, col = l%NC) serially. Activations: quantize_mmq_q8_1 layout, block (kb, col) at kb*NC + col.
+template <int NW, int RW, int NC>
+__global__ void __launch_bounds__(NW*32) bi_nb_q8_0_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int64_t dst_stride, const int nrows, const int nb) {
+    static_assert(NC >= 2 && RW*NC <= 32, "RW*NC");
+    __shared__ int4  sbuf[NW][RW][69];
+    __shared__ float st[NW][RW*NC][33];
+    __shared__ float sd[NW][NC][33];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int w0 = 8*lane + lane/2, sh = (lane & 1) * 16;
+    float acc = 0.0f;
+    const int nchunks = nb / 32;
+    for (int ch = 0; ch < nchunks; ++ch) {
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 3; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 68) sbuf[wy][r][idx] = __ldg(wr + 68*ch + idx);
+            }
+        }
+        const int b = 32*ch + lane;
+        int4 ya[NC], yb[NC];
+#pragma unroll
+        for (int j = 0; j < NC; ++j) {
+            const char * by = y + ((int64_t) (b >> 2)*NC + j)*144;
+            ya[j] = __ldg((const int4 *) (by + 16 + 32*(b & 3)) + 0);
+            yb[j] = __ldg((const int4 *) (by + 16 + 32*(b & 3)) + 1);
+            sd[wy][j][lane] = __ldg((const float *) by + (b & 3));
+        }
+        __syncwarp();
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int * s32 = (const int *) sbuf[wy][r];
+            int w[9];
+#pragma unroll
+            for (int i = 0; i < 9; ++i) w[i] = s32[w0 + i];
+            const float dA = __half2float(__ushort_as_half(uint16_t(uint32_t(w[0]) >> sh)));
+            int v[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) v[i] = (int) __funnelshift_rc((unsigned) w[i], (unsigned) w[i + 1], 16 + sh);
+#pragma unroll
+            for (int j = 0; j < NC; ++j) {
+                int c = 0;
+                c = __dp4a(v[0], ya[j].x, c);
+                c = __dp4a(v[1], ya[j].y, c);
+                c = __dp4a(v[2], ya[j].z, c);
+                c = __dp4a(v[3], ya[j].w, c);
+                c = __dp4a(v[4], yb[j].x, c);
+                c = __dp4a(v[5], yb[j].y, c);
+                c = __dp4a(v[6], yb[j].z, c);
+                c = __dp4a(v[7], yb[j].w, c);
+                st[wy][r*NC + j][lane] = __fmul_rn((float) c, dA);                    // MMQ: FMUL.FTZ C*dA
+            }
+        }
+        __syncwarp();
+        if (lane < RW*NC) {
+            const int j = lane % NC;
+#pragma unroll 8
+            for (int i = 0; i < 32; ++i) {
+                acc = __fmaf_rn(st[wy][lane][i], sd[wy][j][i], acc);                   // MMQ: FFMA.FTZ sum += t*dB
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW*NC && row0 + lane/NC < nrows) {
+        dst[(int64_t) (lane % NC)*dst_stride + row0 + lane/NC] = acc;
+    }
+}
+
+// GGML_CUDA_BI_FAST_NB=0 keeps Q8_0 batches of 2..8 columns on forced MMQ (A/B; both are MMQ-identical).
+static bool ggml_cuda_bi_fast_nb_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BI_FAST_NB");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+// GGML_CUDA_BI_NB_Q4K_LAYOUT (research A/B): unset/other = hybrid (float4 at NC = 2, compact at NC >= 3),
+// "f4" = float4 staging at every NC, "compact" = compact staging at every NC. All three are MMQ-identical.
+static int ggml_cuda_bi_nb_q4k_layout() {
+    static const int layout = [] {
+        const char * e = getenv("GGML_CUDA_BI_NB_Q4K_LAYOUT");
+        if (e && strcmp(e, "f4") == 0)      return 1;
+        if (e && strcmp(e, "compact") == 0) return 2;
+        return 0;
+    }();
+    return layout;
+}
+
+// GGML_CUDA_BI_FAST_NB_KQ=0 keeps only Q4_K/Q6_K batches of 2..8 columns on forced MMQ (A/B).
+static bool ggml_cuda_bi_fast_nb_kq_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BI_FAST_NB_KQ");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+static bool ggml_cuda_bi_fast_n1_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BI_FAST_N1");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+// GGML_CUDA_BI_FAST_N1_KQ=0 disables only the Q4_K/Q6_K kernels (A/B against forced MMQ).
+static bool ggml_cuda_bi_fast_n1_kq_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BI_FAST_N1_KQ");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+// GGML_CUDA_BI_FAST_N1_Q8V3=0 keeps Q8_0 on the original (one row per warp) kernel (A/B; both are MMQ-identical).
+static bool ggml_cuda_bi_fast_n1_q8v3_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BI_FAST_N1_Q8V3");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+bool ggml_cuda_bi_fast_n1_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, const int cc) {
+    // Only where forced MMQ takes the Turing MMA vec_dot whose order is reproduced here (sm_75).
+    if (!ggml_cuda_bi_fast_n1_enabled() || !GGML_CUDA_CC_IS_NVIDIA(cc) || !turing_mma_available(cc) || ampere_mma_available(cc)) {
+        return false;
+    }
+    // N = 1..8 for every type (bi_nb_q8_0_v3, bi_nb_q4_K_v3, bi_nb_q6_K_v3 for N >= 2).
+    const int64_t ne11 = src1->ne[1];
+    if (ne11 < 1 || ne11 > 8 || (ne11 > 1 && !ggml_cuda_bi_fast_nb_enabled())) {
+        return false;
+    }
+    if (ne11 > 1 && src0->type != GGML_TYPE_Q8_0 && !ggml_cuda_bi_fast_nb_kq_enabled()) {
+        return false;
+    }
+    const bool common = src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        src1->ne[2] == 1 && src1->ne[3] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1 &&
+        ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
+        (uintptr_t) src0->data % 16 == 0 && (uintptr_t) src1->data % 16 == 0;
+    if (!common) {
+        return false;
+    }
+    switch (src0->type) {
+        case GGML_TYPE_Q8_0:
+            return src0->ne[0] % 1024 == 0;
+        case GGML_TYPE_Q4_K: // 144-B superblocks keep 16-B row alignment; tail chunks handle ne00 % 1024 != 0
+            return ggml_cuda_bi_fast_n1_kq_enabled() && src0->ne[0] % 512 == 0;
+        case GGML_TYPE_Q6_K: // 210-B superblocks: an even superblock count keeps rows 4-B aligned
+            return ggml_cuda_bi_fast_n1_kq_enabled() && src0->ne[0] % 512 == 0;
+        default:
+            return false;
+    }
+}
+
+void ggml_cuda_mul_mat_bi_fast_n1(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+    cudaStream_t stream = ctx.stream();
+
+    const int64_t ne11 = src1->ne[1];
+    const int64_t s11  = src1->nb[1] / sizeof(float);
+
+    const int64_t ne10_padded = GGML_PAD(ne00, MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), ne11 * ne10_padded/QK8_1_MMQ * sizeof(block_q8_1_mmq));
+    quantize_mmq_q8_1_cuda((const float *) src1->data, nullptr, src1_q8_1.get(), src0->type,
+        ne00, s11, s11*ne11, s11*ne11, ne10_padded, ne11, 1, 1, stream);
+    CUDA_CHECK(cudaGetLastError());
+
+    constexpr int nwarps = 2;
+    if (ne11 > 1) {
+        // 2..8 columns (gated in ggml_cuda_bi_fast_n1_supported)
+        constexpr int rw = 4;
+        const dim3 grid_nb((ne01 + nwarps*rw - 1)/(nwarps*rw), 1, 1);
+        const dim3 block_nb(WARP_SIZE, nwarps, 1);
+        const char * W = (const char *) src0->data;
+        float * d = (float *) dst->data;
+        const int64_t sd = dst->nb[1] / sizeof(float);
+        if (src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q6_K) {
+            const int nsb = (int) (ne00/QK_K);
+            const bool q4 = src0->type == GGML_TYPE_Q4_K;
+            const int lay = ggml_cuda_bi_nb_q4k_layout();
+#define BI_NB_KQ(NCV) \
+            if (q4 && lay == 1) bi_nb_q4_K_v3<nwarps, rw, NCV, false><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nsb); \
+            else if (q4 && lay == 2) bi_nb_q4_K_v3<nwarps, rw, NCV, true><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nsb); \
+            else if (q4) bi_nb_q4_K_v3<nwarps, rw, NCV><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nsb); \
+            else    bi_nb_q6_K_v3<nwarps, rw, NCV><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nsb); \
+            break;
+            switch (ne11) {
+                case 2: BI_NB_KQ(2)
+                case 3: BI_NB_KQ(3)
+                case 4: BI_NB_KQ(4)
+                case 5: BI_NB_KQ(5)
+                case 6: BI_NB_KQ(6)
+                case 7: BI_NB_KQ(7)
+                case 8: BI_NB_KQ(8)
+                default: GGML_ABORT("unsupported ne11");
+            }
+#undef BI_NB_KQ
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
+        const int nb = (int) (ne00/QK8_0);
+        switch (ne11) {
+            case 2: bi_nb_q8_0_v3<nwarps, rw, 2><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 3: bi_nb_q8_0_v3<nwarps, rw, 3><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 4: bi_nb_q8_0_v3<nwarps, rw, 4><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 5: bi_nb_q8_0_v3<nwarps, rw, 5><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 6: bi_nb_q8_0_v3<nwarps, rw, 6><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 7: bi_nb_q8_0_v3<nwarps, rw, 7><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            case 8: bi_nb_q8_0_v3<nwarps, rw, 8><<<grid_nb, block_nb, 0, stream>>>(W, src0->nb[1], src1_q8_1.get(), d, sd, (int) ne01, nb); break;
+            default: GGML_ABORT("unsupported ne11");
+        }
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    const dim3 grid((ne01 + nwarps - 1)/nwarps, 1, 1);
+    const dim3 block(WARP_SIZE, nwarps, 1);
+    switch (src0->type) {
+        case GGML_TYPE_Q8_0:
+            if (ne01 >= 512 && ggml_cuda_bi_fast_n1_q8v3_enabled()) {
+                // v3: 4 rows per warp, lane-parallel fold (identical per-row float program)
+                constexpr int rw = 4;
+                const dim3 grid_q8((ne01 + nwarps*rw - 1)/(nwarps*rw), 1, 1);
+                bi_n1_q8_0_v3<nwarps, rw><<<grid_q8, block, 0, stream>>>(
+                    (const char *) src0->data, src0->nb[1], src1_q8_1.get(), (float *) dst->data, (int) ne01, (int) (ne00/QK8_0));
+            } else {
+                mul_mat_bi_fast_n1_q8_0<nwarps><<<grid, block, 0, stream>>>(
+                    (const char *) src0->data, src0->nb[1], (const block_q8_1_mmq *) src1_q8_1.get(),
+                    (float *) dst->data, (int) ne01, (int) (ne00/QK8_0));
+            }
+            break;
+        case GGML_TYPE_Q4_K: {
+            // v3: 4 rows per warp, lane-parallel fold (same per-row float program as bi_n1_q4_K<.,0>)
+            constexpr int rw = 4;
+            const dim3 grid_kq((ne01 + nwarps*rw - 1)/(nwarps*rw), 1, 1);
+            bi_n1_q4_K_v3<nwarps, rw><<<grid_kq, block, 0, stream>>>(
+                (const char *) src0->data, src0->nb[1], src1_q8_1.get(), (float *) dst->data, (int) ne01, (int) (ne00/QK_K));
+        } break;
+        case GGML_TYPE_Q6_K: {
+            constexpr int rw = 4;
+            const dim3 grid_kq((ne01 + nwarps*rw - 1)/(nwarps*rw), 1, 1);
+            bi_n1_q6_K_v3<nwarps, rw><<<grid_kq, block, 0, stream>>>(
+                (const char *) src0->data, src0->nb[1], src1_q8_1.get(), (float *) dst->data, (int) ne01, (int) (ne00/QK_K));
+        } break;
+        default:
+            GGML_ABORT("unsupported type");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
