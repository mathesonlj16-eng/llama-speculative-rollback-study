+#pragma once
+
+#include "common.cuh"
+
+// Batch-invariant fast path for a single src1 column (research prototype), Q8_0 / Q4_K / Q6_K.
+// Reproduces the per-output float program of forced MMQ on the Turing MMA path (sm_75) bit for bit:
+// same src1 quantization (quantize_mmq_q8_1, D4 or DS4), exact integer block dots, then the MMQ
+// float operations in ascending K order (Q8_0 below; Q4_K/Q6_K in mmq-bi-n1-kq.cuh).
+//   Q8_0: t = float(C)*dA; sum = fma(t, dB, sum)
+// Disable with GGML_CUDA_BI_FAST_N1=0 (all types) or GGML_CUDA_BI_FAST_N1_KQ=0 (Q4_K/Q6_K only).
+bool ggml_cuda_bi_fast_n1_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, int cc);
+
+void ggml_cuda_mul_mat_bi_fast_n1(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
diff --git a/ggml/src/ggml-cuda/mmq-bi-nb-kq.cuh b/ggml/src/ggml-cuda/mmq-bi-nb-kq.cuh
new file mode 100644
index 0000000000..e4b3fd5c2f
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-bi-nb-kq.cuh
@@ -0,0 +1,217 @@
+#pragma once
+// Q4_K / Q6_K, NC = 2..8 columns: the v3 kernels' per-(row, column) float program, unchanged, for each column.
+// Forced MMQ in invariant mode gives every column the N=1 result, so each output here runs exactly the
+// bi_n1_q4_K_v3 / bi_n1_q6_K_v3 fold for its column. Weight chunks (4 superblocks) are staged once per row and
+// their integer dots taken against all NC activation columns; lane l < RW*NC folds (row l/NC, column l%NC)
+// serially. Activations: quantize_mmq_q8_1 layout, 128-value block (kb, col) at kb*NC + col (144 B each).
+// Requires bi_n1_unpack_scales_q45_K and bi_n1_ld32_2 from mmq-bi-n1-kq-v2.cuh.
+
+template <int NW, int RW, int NC, bool CP_ = (NC >= 3)>
+__global__ void __launch_bounds__(NW*32) bi_nb_q4_K_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int64_t dst_stride, const int nrows, const int nsb) {
+    static_assert(NC >= 2 && RW*NC <= 32, "RW*NC");
+    // Two staging layouts, both with the same per-output float operations on the same operands:
+    // - CP (NC >= 3), compact: integer dot per (row, column, group), row scales dmA per (row, group), column scales
+    //   dsB per (column, group); the fold forms t = __fmul_rn(dmA.x, dsB.x) and float(C) itself. A float4 per term
+    //   needs 38 KB of shared memory at NC = 8, which limited occupancy (§18).
+    // - NC = 2, float4 per term (t, float(C), dmA.y, dsB.y) formed in the compute phase: shared memory is not the
+    //   limit there, and the shorter serial fold (only 8 folding lanes) is 11-35% faster than the compact one.
+    constexpr bool CP = CP_;   // default NC >= 3; GGML_CUDA_BI_NB_Q4K_LAYOUT=f4|compact forces one layout (A/B)
+    __shared__ int4   sbuf[NW][RW][36];
+    __shared__ float4 sf[NW][CP ? 1 : RW*NC][33];
+    __shared__ int    sc_[NW][CP ? RW*NC : 1][33];
+    __shared__ float2 sdm[NW][CP ? RW : 1][33];
+    __shared__ float2 sds[NW][CP ? NC : 1][33];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, s = lane & 7;
+    float acc = 0.0f;   // lane l < RW*NC: row row0 + l/NC, column l%NC
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int4 * wr = (const int4 *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < 9*nsbc) sbuf[wy][r][idx] = __ldg(wr + 9*sb0 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + s;
+        int4 ya[NC], yb[NC];
+        float2 dsB[NC];
+#pragma unroll
+        for (int j = 0; j < NC; ++j) {
+            ya[j] = make_int4(0, 0, 0, 0); yb[j] = make_int4(0, 0, 0, 0);
+            half2 dsh = __floats2half2_rn(0.0f, 0.0f);
+            if (sbl < nsbc) {
+                const char * by = y + ((int64_t) (g >> 2)*NC + j)*144;
+                dsh   = __ldg((const half2 *) by + (g & 3));
+                ya[j] = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+                yb[j] = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+            }
+            dsB[j] = __half22float2(dsh);
+            if constexpr (CP) sds[wy][j][lane] = dsB[j];
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+#pragma unroll
+            for (int r = 0; r < RW; ++r) {
+                const int * w = (const int *) sbuf[wy][r] + 36*sbl;
+                const half2 dm = *(const half2 *) w;
+                const int sc32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 0);
+                const int  m32 = bi_n1_unpack_scales_q45_K(w + 1, s/4 + 2);
+                const uint8_t sc8 = (uint8_t) (sc32 >> (8*(s % 4)));
+                const uint8_t  m8 = (uint8_t) ( m32 >> (8*(s % 4)));
+                const half2 dmn = dm * make_half2(1.0f, -1.0f);
+                const float2 dmA = __half22float2(dmn * make_half2(sc8, m8));
+                if constexpr (CP) sdm[wy][r][lane] = dmA;
+                const int4 * q4 = (const int4 *) (w + 4 + 8*(s/2));
+                const int4 qa = q4[0], qb = q4[1];
+                const int sh = 4*(s & 1);
+                const int v0 = (qa.x >> sh) & 0x0F0F0F0F, v1 = (qa.y >> sh) & 0x0F0F0F0F;
+                const int v2 = (qa.z >> sh) & 0x0F0F0F0F, v3 = (qa.w >> sh) & 0x0F0F0F0F;
+                const int v4 = (qb.x >> sh) & 0x0F0F0F0F, v5 = (qb.y >> sh) & 0x0F0F0F0F;
+                const int v6 = (qb.z >> sh) & 0x0F0F0F0F, v7 = (qb.w >> sh) & 0x0F0F0F0F;
+#pragma unroll
+                for (int j = 0; j < NC; ++j) {
+                    int c = 0;
+                    c = __dp4a(v0, ya[j].x, c);
+                    c = __dp4a(v1, ya[j].y, c);
+                    c = __dp4a(v2, ya[j].z, c);
+                    c = __dp4a(v3, ya[j].w, c);
+                    c = __dp4a(v4, yb[j].x, c);
+                    c = __dp4a(v5, yb[j].y, c);
+                    c = __dp4a(v6, yb[j].z, c);
+                    c = __dp4a(v7, yb[j].w, c);
+                    if constexpr (CP) {
+                        sc_[wy][r*NC + j][lane] = c;
+                    } else {
+                        sf[wy][r*NC + j][lane] = make_float4(__fmul_rn(dmA.x, dsB[j].x), (float) c, dmA.y, dsB[j].y);
+                    }
+                }
+            }
+        }
+        __syncwarp();
+        if (lane < RW*NC) {
+            const int ng = 8*nsbc;
+            const int r = lane / NC, j = lane % NC;
+            for (int i = 0; i < ng; ++i) {
+                if constexpr (CP) {
+                    const float2 a = sdm[wy][r][i], b = sds[wy][j][i];
+                    acc = __fmaf_rn(__fmul_rn(a.x, b.x), (float) sc_[wy][lane][i], acc);   // MMQ: sum += (dmA.x*dsB.x)*C
+                    acc = __fmaf_rn(a.y, b.y, acc);                                        // MMQ: sum += dmA.y*dsB.y
+                } else {
+                    const float4 v = sf[wy][lane][i];
+                    acc = __fmaf_rn(v.x, v.y, acc);   // MMQ: sum += (dmA.x*dsB.x)*C
+                    acc = __fmaf_rn(v.z, v.w, acc);   // MMQ: sum += dmA.y*dsB.y
+                }
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW*NC && row0 + lane/NC < nrows) {
+        dst[(int64_t) (lane % NC)*dst_stride + row0 + lane/NC] = acc;
+    }
+}
+
+template <int NW, int RW, int NC>
+__global__ void __launch_bounds__(NW*32) bi_nb_q6_K_v3(
+        const char * __restrict__ W, const int64_t row_stride, const char * __restrict__ y,
+        float * __restrict__ dst, const int64_t dst_stride, const int nrows, const int nsb) {
+    static_assert(NC >= 2 && RW*NC <= 32, "RW*NC");
+    __shared__ int   sbuf[NW][RW][212];
+    __shared__ float scf[NW][RW*NC][33];
+    __shared__ float sdb[NW][NC][33];
+    __shared__ float sda[NW][RW][5];
+    const int row0 = (blockIdx.x*NW + threadIdx.y)*RW;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x, wy = threadIdx.y;
+    const int sbl = lane >> 3, q = lane & 7, n = q >> 2, jj = q & 3;
+    float acc = 0.0f;
+    for (int sb0 = 0; sb0 < nsb; sb0 += 4) {
+        const int nsbc = min(4, nsb - sb0);
+        const int nwords = (210*nsbc)/4;
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int * wr = (const int *) (W + (int64_t) min(row0 + r, nrows - 1)*row_stride);
+#pragma unroll
+            for (int i = 0; i < 7; ++i) {
+                const int idx = lane + 32*i;
+                if (idx < nwords) sbuf[wy][r][idx] = __ldg(wr + (210*sb0)/4 + idx);
+            }
+        }
+        const int g = 8*(sb0 + sbl) + q;
+        int4 ya[NC], yb[NC];
+#pragma unroll
+        for (int j = 0; j < NC; ++j) {
+            ya[j] = make_int4(0, 0, 0, 0); yb[j] = make_int4(0, 0, 0, 0);
+            float dB = 0.0f;
+            if (sbl < nsbc) {
+                const char * by = y + ((int64_t) (g >> 2)*NC + j)*144;
+                dB    = __ldg((const float *) by + (g & 3));
+                ya[j] = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 0);
+                yb[j] = __ldg((const int4 *) (by + 16 + 32*(g & 3)) + 1);
+            }
+            sdb[wy][j][lane] = dB;
+        }
+        __syncwarp();
+        if (sbl < nsbc) {
+            const int base = 210*sbl;
+            const int oql = base + 64*n + 32*(jj & 1);
+            const int oqh = base + 128 + 32*n;
+            const int shl = 4*(jj >> 1), shh = 2*jj;
+#pragma unroll 2
+            for (int r = 0; r < RW; ++r) {
+                const int * s32 = sbuf[wy][r];
+                int v[8];
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int ql = (bi_n1_ld32_2(s32, oql + 4*i) >> shl) & 0x0F0F0F0F;
+                    const int qh = ((bi_n1_ld32_2(s32, oqh + 4*i) >> shh) & 0x03030303) << 4;
+                    v[i] = __vsub4(ql | qh, 0x20202020);
+                }
+                const int8_t * sc = (const int8_t *) s32 + base + 192;
+                const int sc0 = sc[2*q], sc1 = sc[2*q + 1];
+#pragma unroll
+                for (int j = 0; j < NC; ++j) {
+                    int c0 = 0, c1 = 0;
+                    c0 = __dp4a(v[0], ya[j].x, c0);
+                    c0 = __dp4a(v[1], ya[j].y, c0);
+                    c0 = __dp4a(v[2], ya[j].z, c0);
+                    c0 = __dp4a(v[3], ya[j].w, c0);
+                    c1 = __dp4a(v[4], yb[j].x, c1);
+                    c1 = __dp4a(v[5], yb[j].y, c1);
+                    c1 = __dp4a(v[6], yb[j].z, c1);
+                    c1 = __dp4a(v[7], yb[j].w, c1);
+                    scf[wy][r*NC + j][lane] = (float) (c0*sc0 + c1*sc1);
+                }
+                if (q == 0) {
+                    sda[wy][r][sbl] = __half2float(__ushort_as_half(*((const unsigned short *) ((const char *) s32 + base + 208))));
+                }
+            }
+        }
+        __syncwarp();
+        if (lane < RW*NC) {
+            const int r = lane / NC, j = lane % NC;
+            for (int h = 0; h < 2*nsbc; ++h) {
+                float tmp = __fmaf_rn(scf[wy][lane][4*h], sdb[wy][j][4*h], 0.0f);       // MMQ: tmp = Cf*dB + RZ
+#pragma unroll
+                for (int k = 1; k < 4; ++k) {
+                    tmp = __fmaf_rn(scf[wy][lane][4*h + k], sdb[wy][j][4*h + k], tmp);  // MMQ: tmp += Cf*dB
+                }
+                acc = __fmaf_rn(tmp, sda[wy][r][h >> 1], acc);                           // MMQ: sum += tmp*dA
+            }
+        }
+        __syncwarp();
+    }
+    if (lane < RW*NC && row0 + lane/NC < nrows) {
+        dst[(int64_t) (lane % NC)*dst_stride + row0 + lane/NC] = acc;
+    }
+}
