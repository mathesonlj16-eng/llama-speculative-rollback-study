+// Research counterfactual: dequantize the Q8_0 weight row and take an F32 dot with the unrounded activation.
+void dequantize_row_q8_0(const void * GGML_RESTRICT src, float * GGML_RESTRICT dst, int64_t n);
+static long q35_exact_calls = 0;
+static void q35_vec_dot_q8_0_exact(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT x, size_t bx,
+                                   const void * GGML_RESTRICT y, size_t by, int nrc) {
+    static __thread float * row = NULL;
+    static __thread int cap = 0;
+    (void) bs; (void) bx; (void) by; (void) nrc;
+    if (n > cap) {
+        free(row);
+        row = (float *) malloc((size_t) n * sizeof(float));
+        cap = n;
+    }
+    dequantize_row_q8_0(x, row, n);
+    ggml_vec_dot_f32(n, s, 0, row, 0, (const float *) y, 0, 1);
+    __atomic_add_fetch(&q35_exact_calls, 1, __ATOMIC_RELAXED);
+}
+__attribute__((destructor)) static void q35_exact_report(void) {
+    fprintf(stderr, "EXACT_ACTIVATION calls=%ld\n", q35_exact_calls);
+}
