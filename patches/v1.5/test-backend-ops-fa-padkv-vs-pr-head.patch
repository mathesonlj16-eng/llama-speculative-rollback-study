+// Like test_flash_attn_ext_batch_inv, but with the K/V length llama.cpp actually uses: the KV cache
+// view is padded to a multiple of `pad` cells (llama_kv_cache::get_n_kv, n_pad = 256) from the
+// furthest position written so far. Batch: nb queries at positions p0..p0+nb-1 see
+// GGML_PAD(p0+nb, pad) cells. Single token j sees GGML_PAD(p0+j+1, pad) cells. Unmasked cells are
+// identical in both, so a batch-invariant result must not depend on the padded length.
+struct test_flash_attn_ext_batch_inv_padkv : public test_batch_invariance {
+    const int64_t hs, nh, gqa, p0, nb, pad;
+    const ggml_type type_KV;
+
+    std::string op_desc(ggml_tensor * t) override { GGML_UNUSED(t); return "FLASH_ATTN_EXT"; }
+    std::string vars() override { return VARS_TO_STR7(hs, nh, gqa, p0, nb, pad, type_KV); }
+
+    test_flash_attn_ext_batch_inv_padkv(int64_t hs, int64_t nh, int64_t gqa, int64_t p0, int64_t nb,
+            ggml_type type_KV = GGML_TYPE_F16, int64_t pad = 256)
+        : hs(hs), nh(nh), gqa(gqa), p0(p0), nb(nb), pad(pad), type_KV(type_KV) {}
+
+    int64_t len(int64_t n_pos) const { return GGML_PAD(n_pos, pad); }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t kv = len(p0 + nb);
+        ggml_tensor * q0 = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, hs, nh*gqa, nb); ggml_set_name(q0, "q");
+        ggml_tensor * k  = ggml_new_tensor_3d(ctx, type_KV, hs, kv, nh);           ggml_set_name(k, "k");
+        ggml_tensor * v  = ggml_new_tensor_3d(ctx, type_KV, hs, kv, nh);           ggml_set_name(v, "v");
+        ggml_tensor * m  = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, kv, nb);         ggml_set_name(m, "m");
+
+        const auto fa = [&](ggml_tensor * q, ggml_tensor * kk, ggml_tensor * vv, ggml_tensor * mask) {
+            ggml_tensor * res = ggml_flash_attn_ext(ctx, ggml_permute(ctx, q, 0, 2, 1, 3), kk, vv, mask, 1.0f/sqrtf(hs), 0.0f, 0.0f);
+            ggml_prec_set_acc(res, GGML_PREC_F32);
+            return res;
+        };
+
+        ggml_tensor * out = fa(q0, k, v, m);
+        for (int64_t j = 0; j < nb; j++) {
+            const int64_t kv_j = len(p0 + j + 1);
+            ggml_tensor * q_j = ggml_view_3d(ctx, q0, hs, nh*gqa, 1, q0->nb[1], q0->nb[2], j*q0->nb[2]);
+            ggml_tensor * k_j = ggml_view_3d(ctx, k, hs, kv_j, nh, k->nb[1], k->nb[2], 0);
+            ggml_tensor * v_j = ggml_view_3d(ctx, v, hs, kv_j, nh, v->nb[1], v->nb[2], 0);
+            ggml_tensor * m_j = ggml_view_2d(ctx, m, kv_j, 1, m->nb[1], j*m->nb[1]);
+            out = ggml_concat(ctx, out, fa(q_j, k_j, v_j, m_j), 2);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        const int64_t kv = len(p0 + nb);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "m") == 0) {
+                // causal: query j (position p0+j) sees cells 0..p0+j
+                std::vector<ggml_fp16_t> data(kv*nb);
+                for (int64_t j = 0; j < nb; j++) {
+                    for (int64_t i = 0; i < kv; i++) {
+                        data[j*kv + i] = ggml_fp32_to_fp16(i <= p0 + j ? 0.0f : -INFINITY);
+                    }
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
