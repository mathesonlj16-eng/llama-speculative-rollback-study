+static std::vector<ggml_type> sm75_types(const char * v) {
+    std::vector<ggml_type> r; std::stringstream ss(v); std::string t;
+    while (std::getline(ss, t, ',')) {
+        bool ok = false;
+        for (int i = 0; i < GGML_TYPE_COUNT; i++) {
+            const char * nm = ggml_type_name((ggml_type) i);
+            if (nm && strcasecmp(nm, t.c_str()) == 0) { r.push_back((ggml_type) i); ok = true; break; }
+        }
+        if (!ok) { fprintf(stderr, "unknown type %s\n", t.c_str()); exit(1); }
