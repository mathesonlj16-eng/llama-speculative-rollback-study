+static std::vector<int64_t> sm75_ints(const char * v) {
+    std::vector<int64_t> r; std::stringstream ss(v); std::string t;
+    while (std::getline(ss, t, ',')) { if (!t.empty()) r.push_back(std::stoll(t)); }
